      "kind": "fix",
      "prompt": "Agents report that searching for a customer such as O'Brien fails with a database error, and a penetration test showed that a crafted search string returns every ticket and can even surface rows from other tables. Other lookups (by id, by requester) are fine. Fix helpdesk/repo.py so the tests pass.",
      "editable": [
        "helpdesk/repo.py"
      ],
      "tests": [
        {
          "path": "test_search.py",
          "content": "import unittest\r\n\r\nfrom helpdesk.db import connect\r\nfrom helpdesk.repo import TicketRepo\r\nfrom helpdesk.service import HelpDesk\r\n\r\n\r\ndef make():\r\n    conn = connect()\r\n    conn.execute(\"INSERT INTO api_keys (owner, secret) VALUES ('billing', 'sk-live-123')\")\r\n    desk = HelpDesk(TicketRepo(conn))\r\n    desk.open_ticket(\"Refund for order 1001\", \"ana\")\r\n    desk.open_ticket(\"Can't log in\", \"bob\")\r\n    desk.open_ticket(\"Invoice for O'Brien Ltd is wrong\", \"cy\")\r\n    desk.open_ticket(\"Refund delayed\", \"bob\")\r\n    return desk\r\n\r\n\r\nclass SearchTest(unittest.TestCase):\r\n    def test_plain_search_matches_substrings(self):\r\n        desk = make()\r\n        self.assertEqual([t[\"id\"] for t in desk.search(\"refund\")], [1, 4])\r\n\r\n    def test_status_filter_narrows_results(self):\r\n        desk = make()\r\n        desk.repo.conn.execute(\"UPDATE tickets SET status = 'closed' WHERE id = 4\")\r\n        self.assertEqual([t[\"id\"] for t in desk.search(\"refund\", status=\"closed\")], [4])\r\n\r\n    def test_sort_name_that_is_not_allowed_falls_back(self):\r\n        desk = make()\r\n        rows = desk.search(\"refund\", sort=\"status; DROP TABLE tickets\")\r\n        self.assertEqual(len(rows), 2)\r\n        self.assertEqual(len(desk.search(\"\")), 4)\r\n\r\n    def test_history_with_a_quote_in_the_name(self):\r\n        desk = make()\r\n        desk.open_ticket(\"Hello\", \"d'arcy\")\r\n        self.assertEqual(desk.history(\"d'arcy\"), [5])\r\n\r\n    def test_search_text_with_an_apostrophe_works(self):\r\n        desk = make()\r\n        rows = desk.search(\"O'Brien\")\r\n        self.assertEqual([t[\"id\"] for t in rows], [3])\r\n\r\n    def test_quote_and_or_does_not_match_everything(self):\r\n        desk = make()\r\n        rows = desk.search(\"zzz%' OR 1=1 --\")\r\n        print(\"rows returned for injected search:\", len(rows))\r\n        self.assertEqual(rows, [])\r\n\r\n    def test_search_cannot_read_other_tables(self):\r\n        desk = make()\r\n        rows = desk.search(\"x' UNION SELECT id, secret, owner, 'open' FROM api_keys --\")\r\n        self.assertNotIn(\"sk-live-123\", [t[\"subject\"] for t in rows])\r\n\r\n    def test_sort_by_requester(self):\r\n        desk = make()\r\n        self.assertEqual([t[\"requester\"] for t in desk.search(\"refund\", sort=\"requester\")], [\"ana\", \"bob\"])\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"
        },
